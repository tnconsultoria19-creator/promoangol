{
  "name": "promoangol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply PROMOANGOL_DB",
    "db:migrate:local": "wrangler d1 migrations apply PROMOANGOL_DB --local",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.59.0",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.1",
    "wrangler": "^4.138.0"
  }
}
