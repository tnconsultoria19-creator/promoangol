{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "promoangol",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-24",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "PROMOANGOL_DB",
      "database_name": "promoangol-db",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROMOANGOL_FILES",
      "bucket_name": "promoangol-files"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
