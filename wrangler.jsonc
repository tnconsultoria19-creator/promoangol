{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "promoangol",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "PROMOANGOL_DB",
      "database_name": "promoangol-db",
      "database_id": "d8107b9e-1c96-44ac-8dc7-2d8d80bed463",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROMOANGOL_FILES",
      "bucket_name": "promoangol-files"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
